{
  "name": "@waterbox/api",
  "version": "0.1.0-alpha.1",
  "description": "Provider-neutral Fetch and OpenAPI transport for the Waterbox control plane.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bros4president/waterbox.git",
    "directory": "packages/sandbox-api"
  },
