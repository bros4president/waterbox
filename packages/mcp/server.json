{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.waterbox/mcp",
  "title": "Waterbox",
  "description": "Runs coding tools in an isolated remote sandbox",
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@waterbox/mcp",
      "version": "0.1.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "WATERBOX_PROVIDER",
          "value": "box",
          "description": "The direct sandbox provider"
        },
        {
          "name": "BOX_API_KEY",
          "description": "Box API key. Configure it using the MCP client's recommended secret or environment mechanism.",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "BOX_SYSTEM_TEMPLATE_REF",
          "description": "Box system template",
          "default": "waterbox-system-v6"
        }
      ]
    }
  ]
}
