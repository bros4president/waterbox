{
  "name": "@waterbox/mcp",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "waterbox-mcp": "./dist/waterbox-mcp.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist/index.js",
    "dist/waterbox-mcp.js",
    "README.md",
    "server.json"
  ],
  "scripts": {
    "build": "bun build ./src/main.ts --target=bun --outfile ./dist/waterbox-mcp.js && bun build ./src/index.ts --target=bun --outfile ./dist/index.js",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.25.3",
    "@waterbox/contracts": "workspace:*",
    "@waterbox/core": "workspace:*",
    "@waterbox/provider-box": "workspace:*",
    "@waterbox/repository-sqlite": "workspace:*",
    "age-encryption": "0.3.1",
    "zod": "4.1.8"
  },
  "engines": {
    "bun": ">=1.3.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
