{
  "name": "oc-remote",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "deploy": "bun run scripts/deploy.ts",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:pi-mcp": "bun run scripts/pi-mcp-smoke.ts",
    "chat:pi-mcp": "bun run scripts/pi-mcp-chat.ts",
    "build:box-template": "bun run scripts/box-template-builder.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-iam": "^3.883.0",
    "@aws-sdk/client-lambda-microvms": "^3.1116.0",
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/client-sts": "^3.883.0",
    "@aws-sdk/credential-providers": "^3.883.0",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@modelcontextprotocol/sdk": "1.25.3",
    "@opencode-ai/plugin": "0.0.0-beta-17823"
  },
  "devDependencies": {
    "@opencode-ai/cli": "0.0.0-beta-17963",
    "@types/bun": "latest",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "trustedDependencies": [
    "@opencode-ai/cli"
  ]
}
