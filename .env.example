# Placeholders only. Copy required values into your local environment; never commit secrets.
WATERBOX_API_HOST=127.0.0.1
WATERBOX_API_PORT=8787
WATERBOX_SQLITE_PATH=.waterbox/control-plane.sqlite
WATERBOX_DEV_API_KEY=replace-with-development-key
WATERBOX_DEV_ACCOUNT_ID=replace-with-account-id
BOX_API_BASE_URL=https://ascii.dev/api/box/v1
BOX_API_KEY=replace-with-box-api-key
BOX_SYSTEM_TEMPLATE_REF=replace-with-system-template-name
BOX_POLL_INTERVAL_MS=1000
BOX_POLL_TIMEOUT_MS=120000
# Destructive smoke-only gates; leave disabled except during an explicitly authorized run.
WATERBOX_BOX_SMOKE_AUTHORIZED=NO
WATERBOX_BOX_SMOKE_ISOLATED_ACCOUNT=NO
WATERBOX_API_URL=http://127.0.0.1:8787
WATERBOX_SMOKE_POLL_INTERVAL_MS=1000
WATERBOX_SMOKE_POLL_TIMEOUT_MS=180000
